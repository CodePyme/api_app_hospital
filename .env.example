# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PUERTO=3000
ENTORNO=development

# =============================================
# BASE DE DATOS POSTGRESQL
# =============================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_paciente
DB_USERNAME=
DB_PASSWORD=
DB_SINCRONIZAR=true
DB_REGISTRO=false

# =============================================
# CORS — Orígenes permitidos
# =============================================
# En desarrollo: dejar vacío para permitir cualquier origen (*)
# En producción: lista separada por comas con los dominios del frontend
# Ejemplo producción:
# CORS_ORIGINS=https://portal.runasalud.com,https://admin.runasalud.com
CORS_ORIGINS=

# =============================================
# AUTENTICACIÓN JWT
# =============================================
JWT_SECRETO=
JWT_EXPIRACION=1d
