# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PUERTO=3000
ENTORNO=development

# =============================================
# BASE DE DATOS POSTGRESQL
# =============================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_paciente
DB_USERNAME=
DB_PASSWORD=
DB_SINCRONIZAR=true
DB_REGISTRO=false

# =============================================
# AUTENTICACIÓN JWT
# =============================================
# Obligatorio: la aplicación no arranca si falta. Usar un valor largo y aleatorio
# (ej. `openssl rand -base64 48`), distinto por entorno. Nunca dejar vacío ni reutilizar
# este archivo de ejemplo como valor real.
JWT_SECRETO=
JWT_EXPIRACION=1d

# =============================================
# SEEDER DE USUARIO ADMINISTRADOR
# =============================================
# Si se deja vacío, el seeder NO crea la cuenta admin@codepyme.com (comportamiento seguro
# por defecto). Para sembrarla, definir una contraseña fuerte y única por entorno.
ADMIN_SEED_PASSWORD=

# =============================================
# CORS — Orígenes permitidos
# =============================================
# En desarrollo: dejar vacío para permitir cualquier origen (*)
# En producción: lista separada por comas con los dominios del frontend
# Ejemplo producción:
# CORS_ORIGINS=https://portalpacientesf.codepyme.io,https://admin.runasalud.com
CORS_ORIGINS=

# =============================================
# INTEGRACIÓN HOSPITAL / SAP (DATOS DEMOGRÁFICOS)
# =============================================
# Desarrollo:  http://aspod.hospital.com:50000/RESTAdapter/integra_dev/v1/datosdemograficospaciente
# Calidad:     http://aspod.hospital.com:50000/RESTAdapter/integra_qas/v1/datosdemograficospaciente
# Producción:  http://aspop.hospital.com:50000/RESTAdapter/integra_prd/v1/datosdemograficospaciente
DEMOGRAFICOS_API_URL=http://aspod.hospital.com:50000/RESTAdapter/integra_dev/v1/datosdemograficospaciente
DEMOGRAFICOS_TIMEOUT_MS=8000
DEMOGRAFICOS_AUTH_USER=
DEMOGRAFICOS_AUTH_PASS=

# =============================================
# CORREO ELECTRÓNICO (SMTP / AMAZON SES)
# =============================================
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificacion@codepyme.com
MAIL_FROM_NAME="Portal paciente"
# ADVERTENCIA: si se define, TODOS los OTP de TODOS los pacientes se envían a esta
# dirección en vez de a la suya. Solo debe usarse para pruebas puntuales en un entorno
# de desarrollo/QA aislado, y nunca dejarse configurada en producción.
MAIL_OVERRIDE_DESTINATARIO=
